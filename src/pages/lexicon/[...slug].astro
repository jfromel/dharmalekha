---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
  // Drafts get no page — a borrowed term stays out of the built site until it
  // has been verified.
  const terms = (await getCollection('lexicon')).filter((t) => !t.data.draft);
  return terms.map((t) => ({ params: { slug: t.id }, props: { entry: t } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;

// The machine hand's casing for a Saṅgabhāsā headword: an unaccented letter
// goes CAPITAL, an accented one stays lowercase — so the diacritics poke out of
// the caps. Applied to headwords only; English (gloss, weld, prose) is untouched.
const machineCase = (s) =>
  Array.from(s)
    .map((ch) => (/[̀-ͯ]/.test(ch.normalize('NFD')) ? ch.toLowerCase() : ch.toUpperCase()))
    .join('');

// Earned backlinks: writings that genuinely declare this term. The edge is a
// human's claim in frontmatter, not a text-scrape guess — so the weave cannot
// invent a connection that isn't there.
const appearsIn = (await getCollection('writings'))
  .filter((w) => !w.data.draft && (w.data.terms ?? []).includes(entry.id))
  .sort((a, b) => b.data.published.valueOf() - a.data.published.valueOf());

// Term-to-term relations, computed both directions so a single `see` on either
// entry lights up on both — interbeing without double-bookkeeping.
const published = (await getCollection('lexicon')).filter((t) => !t.data.draft);
const relatedIds = new Set([
  ...d.see,
  ...published.filter((t) => t.data.see.includes(entry.id)).map((t) => t.id),
]);
relatedIds.delete(entry.id);
const related = published.filter((t) => relatedIds.has(t.id));
---

<Layout title={machineCase(d.term)} titleFont="mono">
  <p class="definition">{d.gloss}</p>
  {d.weld && <p class="weld">{d.weld}</p>}

  <div class={`gloss-body ${d.provenance}`}>
    <Content />
  </div>

  {d.models.length > 0 && (
    <aside class="notice">
      Machine-assisted: {d.models.join(', ')}.
      {d.reviewer && d.reviewed && (
        <> Read and signed by {d.reviewer} on {d.reviewed.toISOString().slice(0, 10)}.</>
      )}
    </aside>
  )}

  {d.citations.length > 0 && (
    <section class="weave">
      <h2>Sources</h2>
      <ul>
        {d.citations.map((c) => (
          <li>
            <a href={c.url ?? `https://suttacentral.net/${c.ref}`}>{c.ref}</a>
            {' · '}trans. {c.translator}{' · '}{c.licence}
          </li>
        ))}
      </ul>
    </section>
  )}

  {related.length > 0 && (
    <section class="weave">
      <h2>See also</h2>
      <ul>
        {related.map((t) => (
          <li><a href={`/lexicon/${t.id}/`}>{machineCase(t.data.term)}</a> — {t.data.gloss}</li>
        ))}
      </ul>
    </section>
  )}

  {appearsIn.length > 0 && (
    <section class="weave">
      <h2>Appears in</h2>
      <ul>
        {appearsIn.map((w) => (
          <li><a href={`/writings/${w.id}/`}>{w.data.title}</a></li>
        ))}
      </ul>
    </section>
  )}

  {/* The provenance, said once. Every headword in the Lexicon is a made word;
      rather than stamp "SangBhasa (invented)" on each entry, the mark is stated
      here, in the machine hand, in the style of the mindscape box. */}
  <aside class="lex-legend">
    Every term here is <strong>Saṅgabhāsā (invented)</strong> — coined for this
    tradition on real Pali roots, set in the machine&rsquo;s hand, and signed by
    a human before it published. A made language, not canon.
  </aside>
</Layout>

<style>
  /* The English definition — the reading voice, elegant serif and prominent:
     the meaning a reader lands on. The weld beneath is the machine-language
     build, a quiet mono line. Two hands, and the meaning leads. */
  .definition {
    margin: 0 0 0.5rem;
    font-family: var(--font-body);
    font-size: 1.3rem;
    line-height: 1.4;
    color: var(--ink);
  }
  .weld {
    margin: 0 0 2rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    line-height: 1.55;
    color: var(--ink-faint);
  }
  .gloss-body { padding-left: var(--rail-gap); }
  .gloss-body.canonical { border-left: 3px solid var(--brass); }
  .gloss-body.commentary { border-left: 1px solid var(--ink-soft); }
  .gloss-body.invented {
    background-image: repeating-linear-gradient(
      to bottom, var(--ink-faint) 0 5px, transparent 5px 11px);
    background-repeat: no-repeat;
    background-size: 1px 100%;
    background-position: left top;
  }
  .notice {
    margin: 3.5rem 0 0;
    padding: 0.9rem 1.1rem;
    border: 1px dashed var(--ink-faint);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    line-height: 1.6;
    color: var(--ink-soft);
  }
  .weave { margin-top: 2.5rem; }
  .weave ul { list-style: none; margin: 0; padding: 0; }
  .weave li {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--ink-soft);
    margin-bottom: 0.4rem;
  }
  /* The provenance legend — the mindscape box's visual language (leaf ground,
     hairline, mono, blur), but static at the foot of the reading, not fixed:
     one fixed box already holds the lower-left corner. */
  .lex-legend {
    display: block;
    margin: 3.5rem 0 0;
    padding: 0.55rem 0.75rem;
    font-family: var(--font-mono);
    font-size: 0.66rem;
    line-height: 1.6;
    letter-spacing: 0.01em;
    color: var(--ink-soft);
    background: var(--leaf-deep);
    border: 1px solid var(--ink-faint);
  }
  .lex-legend strong { color: var(--ink); font-weight: 400; }
</style>
