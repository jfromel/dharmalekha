---
/*
 * GalleryGrid — the masonry of tiles, rendered once per language so the images
 * appear in both EN and SB modes (the Layout shows only one language slot at a
 * time). `lang` picks the title/blurb; in the SB slot the captions inherit the
 * machine hand (mono) and the site casing script, like the rest of Saṅgabhāsā.
 */
import gallery from '../data/gallery.json';
const { lang = 'en' } = Astro.props;
const idOf = (src) => src.replace(/\.png$/i, '');
const pick = (o, k) => (lang === 'sb' ? (o['sb' + k[0].toUpperCase() + k.slice(1)] ?? o[k]) : o[k]);
---

{gallery.sections.map((section) => (
  <section class="gsection" id={`${section.id}-${lang}`}>
    <h2>{pick(section, 'title')}</h2>
    <p class="blurb">{pick(section, 'blurb')}</p>
    <div class="masonry">
      {section.items.map((item) => {
        const id = idOf(item.src);
        const title = pick(item, 'title');
        return (
          <figure class="tile">
            <button
              class="tile-btn"
              data-full={`/gallery/full/${id}.webp`}
              data-orig={`/gallery/orig/${item.src}`}
              data-title={title}
              data-after={item.after ?? ''}
              aria-label={`Open ${title}`}
            >
              <img src={`/gallery/thumb/${id}.webp`} alt={title} loading="lazy" decoding="async" />
            </button>
            <figcaption>
              <span class="cap-title">{title}</span>
              {item.after && <span class="cap-after">{item.after}</span>}
            </figcaption>
          </figure>
        );
      })}
    </div>
  </section>
))}

<style>
  .gsection { margin: 0 0 3.5rem; }
  .gsection h2 { margin: 0 0 0.2rem; }
  .blurb { font-style: italic; color: var(--ink-soft); margin: 0 0 1.5rem; font-size: 0.95rem; }
  /* Masonry via CSS columns — every image uncropped at its own aspect. */
  .masonry { column-width: 240px; column-gap: 1rem; }
  .tile { break-inside: avoid; margin: 0 0 1rem; padding: 0; }
  .tile-btn {
    display: block; width: 100%; padding: 0; border: 0; cursor: zoom-in;
    background: none; border-radius: 4px; overflow: hidden; line-height: 0;
    box-shadow: 0 1px 4px rgba(0,0,0,0.12);
  }
  .tile-btn img { width: 100%; height: auto; display: block; transition: transform 0.5s ease, filter 0.5s ease; }
  .tile-btn:hover img { transform: scale(1.03); filter: brightness(1.04); }
  .tile-btn:focus-visible { outline: 2px solid var(--brass); outline-offset: 2px; }
  figcaption { margin: 0.4rem 0.1rem 0; }
  .cap-title { display: block; font-size: 0.82rem; line-height: 1.35; color: var(--ink); }
  .cap-after { display: block; font-size: 0.72rem; font-style: italic; color: var(--ink-faint); }
</style>
