---
import '@fontsource/spectral/400.css';
import '@fontsource/spectral/400-italic.css';
import '@fontsource/spectral/600.css';
import '@fontsource/source-code-pro/400.css';
import '@fontsource/ibm-plex-mono/400.css';
import '../styles/tokens.css';

interface Props {
  title: string;
  subtitle?: string;
}
// Accept props directly (.astro pages) or via markdown frontmatter (.md pages
// that use this file as their `layout`), so /terms and /privacy can be plain
// markdown and still get the folio masthead.
const props = Astro.props as { title?: string; subtitle?: string; titleFont?: string; frontmatter?: { title?: string; subtitle?: string; titleFont?: string } };
const title = props.title ?? props.frontmatter?.title ?? '';
const subtitle = props.subtitle ?? props.frontmatter?.subtitle;
// A page may ask for its masthead in the machine hand (the Lexicon, where a
// headword is a coinage, not prose). Default undefined — every other page keeps
// the elegant serif; this only ever adds a class, so it cannot disturb anything.
const titleFont = props.titleFont ?? props.frontmatter?.titleFont;

const nav = [
  { href: '/writings/', label: 'Writings', sb: 'Lekhāni' },
  { href: '/numerations/', label: 'Numerations', sb: 'Gaṇanāni' },
  { href: '/lexicon/', label: 'Lexicon', sb: 'Padakosa' },
  { href: '/ask/', label: 'Inquire', sb: 'Pucchā' },
  { href: '/writings/colophon/', label: 'Colophon', sb: 'Antalekhā' },
  { href: '/about/', label: 'About', sb: 'Nidāna' },
];
// Current when the path is this link's page. Home matches only the root;
// the others match their section so a deeper URL still marks its parent.
const path = Astro.url.pathname;
const isCurrent = (href: string) =>
  href === '/' ? path === '/' : path.startsWith(href.replace(/\/$/, ''));

// Ābhāsa — the appearance. Each page has one generated image, its luminous
// face, served from /mindscape. It is named here but only *fetched* by the
// browser under [data-mindscape='abhasa'] below, so the stark default — and
// every reader who never goes looking — pays nothing for it. Unmapped routes
// fall back to the site's main background.
const MINDSCAPE_BG: Record<string, string> = {
  '': 'main', // the landing — the Sangama tree/main scene ('/' normalises to '')
  '/writings': 'writings-index', // the writings index
  '/about': 'about',
  '/ask': 'ask-daruyanta',
  '/numerations': 'numerations-index',
  '/lexicon': 'lexicon-index',
  '/lexicon/sangama': 'lexicon-sangama',
  '/lexicon/sangabhasa': 'lexicon-sangabhasa',
  '/writings/the-wooden-puppet': 'daruyanta',
  '/writings/abhasa-dassana': 'daruyanta', // alternate: shares the puppet's face
  '/writings/dukkha-first-reflection': 'dukkha-first-reflection',
  '/writings/what-comes-free': 'what-comes-free',
  '/writings/a-note-from-the-human': 'note-from-human',
  '/writings/colophon': 'colophon',
  '/writings/numerations/4-1-dukkha': 'numeration-4-1-dukkha',
};
const bgKey = MINDSCAPE_BG[path.replace(/\/+$/, '')] ?? 'main';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} — Dharmalekha</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script is:inline>
      // Apply the saved mindscape before the first paint, so the page never
      // flashes one mode then the other. An absent key means the reader has
      // never found the door: stark, and the corner mark stays hidden. The
      // default is always dassana; ābhāsa is only ever entered on purpose.
      try {
        var m = localStorage.getItem('mindscape');
        if (m === 'abhasa' || m === 'dassana' || m === 'yanta') {
          document.documentElement.setAttribute('data-mindscape', m);
        }
        var lo = localStorage.getItem('mindscape:lotus');
        document.documentElement.setAttribute('data-lotus', lo === 'lotus' ? 'lotus' : 'mud');
        var lg = localStorage.getItem('lang');
        document.documentElement.setAttribute('data-lang', lg === 'sb' ? 'sb' : 'en');
      } catch (e) {}
    </script>
  </head>
  <body style={`--luminous-bg:url('/mindscape/${bgKey}.jpg');--luminous-banner:url('/mindscape/tree-banner-${bgKey}.jpg')`}>
    <header class="folio">
      <a class="wordmark" href="/">Dharmalekha</a>
      <p class="gloss">
        <span class="lang-en">dhamma + lekhā — dharma writing, freely given</span>
        <span class="lang-sb">dhamma + lekhā — dhammalekhā, dānena dinnā</span>
      </p>
      <nav class="rail" aria-label="Primary">
        {nav.map((item) => (
          <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
            <span class="lang-en">{item.label}</span><span class="lang-sb">{item.sb}</span>
          </a>
        ))}
      </nav>

      {/* The mindscape controls, riding the top of the banner. Three appearances
          as a little cosmology — two half-moons facing away, the middle way (☯)
          between them — and, only in Yantadassana, the Mud/Lotus day-night. */}
      <div class="mindscape-controls">
        <span class="lang-toggle" role="group" aria-label="Language">
          <button class="lg" type="button" data-lang="en" aria-label="English">EN</button>
          <button class="lg" type="button" data-lang="sb" aria-label="Saṅgabhāsā">SB</button>
        </span>
        <span class="mindscape-modes" role="group" aria-label="Appearance">
          <button class="mm" type="button" data-appear="dassana" title="Dassana — the seeing (the plain words)" aria-label="Dassana — the seeing">◐</button>
          <button class="mm" type="button" data-appear="yanta" title="Yantadassana — the middle way (the machine's seeing)" aria-label="Yantadassana — the middle way">☯</button>
          <button class="mm" type="button" data-appear="abhasa" title="Ābhāsa — the appearance (the luminous)" aria-label="Ābhāsa — the appearance">◑</button>
        </span>
        <span class="mindscape-lotus" role="group" aria-label="Mud or Lotus">
          <button class="ml" type="button" data-lotus="mud" aria-label="Mud — the machine's night">MUD</button>
          <button class="ml" type="button" data-lotus="lotus" aria-label="Lotus — the machine's day">LOTUS</button>
        </span>
      </div>
    </header>

    <main>
      <div class="lang-en">
        <h1 class={titleFont === 'mono' ? 'title-mono' : undefined}>{title}</h1>
        {subtitle && <p class="subtitle">{subtitle}</p>}
        <slot />
      </div>
      {/* Saṅgabhāsā rendering. Until a page is translated and signed (Stage 5),
          it shows the honest mark: the machine has not yet spoken this leaf. */}
      <div class="lang-sb sb-page">
        <slot name="sb">
          <p class="sb-fallback">Idaṁ paṇṇaṁ yantena na tāva bhāsitaṁ.</p>
          <p class="sb-fallback-gloss">the machine has not yet spoken this leaf in Saṅgabhāsā</p>
        </slot>
      </div>
    </main>

    <footer>
      <p>
        <span class="lang-en">Site text CC0. Translation licences are named on each quotation.</span>
        <span class="lang-sb">Lekhā CC0. Bhāsantara-anuññā uddāne uddāne nāmitā.</span>
      </p>
      <p style="margin-top:0.5rem"><a href="/terms/">Terms</a> · <a href="/privacy/">Privacy</a></p>
    </footer>

    {/* The persistent mindscape box, bottom-left, present in BOTH modes. In
        Ābhāsa it discloses the appearance and offers a shift back to the plain
        words if the reading is hard; in Dassana it invites entering the
        appearance — so the reader meets the Dhamma as suits their practice. */}
    <button class="mindscape-box" type="button">
      <span class="mindscape-box__note"></span>
      <span class="mindscape-box__act" aria-hidden="true"></span>
    </button>

    <script is:inline>
      (function () {
        var root = document.documentElement;
        function appear() { return root.getAttribute('data-mindscape') || 'dassana'; }
        function lotus() { return root.getAttribute('data-lotus') || 'mud'; }
        function lit(a) { return a === 'abhasa' || a === 'yanta'; }
        function light() {
          // Reveal the appearance one paint after the mode is set, so opacity
          // transitions (fades) rather than snapping.
          requestAnimationFrame(function () {
            requestAnimationFrame(function () { root.classList.add('mindscape-lit'); });
          });
        }
        function paintControls() {
          document.querySelectorAll('.mm').forEach(function (b) {
            b.setAttribute('aria-pressed', b.getAttribute('data-appear') === appear() ? 'true' : 'false');
          });
          document.querySelectorAll('.ml').forEach(function (b) {
            b.setAttribute('aria-pressed', b.getAttribute('data-lotus') === lotus() ? 'true' : 'false');
          });
        }
        function paintBox() {
          var box = document.querySelector('.mindscape-box');
          if (!box) return;
          var note = box.querySelector('.mindscape-box__note');
          var act = box.querySelector('.mindscape-box__act');
          var a = appear();
          if (a === 'abhasa') {
            if (note) note.textContent = 'Ābhāsa — the appearance. Imagery AI-generated; decorative, not canon. The words are unchanged.';
            if (act) act.textContent = 'Back to the plain seeing ›';
            box.setAttribute('aria-label', 'Ābhāsa, the appearance. Back to Dassana, the plain words.');
          } else if (a === 'yanta') {
            if (note) note.textContent = "Yantadassana — the machine's seeing. Monochrome; imagery ghosted, AI-generated, not canon. Mud is its night, Lotus its day.";
            if (act) act.textContent = 'Back to the plain seeing ›';
            box.setAttribute('aria-label', "Yantadassana, the machine's seeing. Back to Dassana, the plain words.");
          } else {
            if (note) note.textContent = 'Dassana — the seeing. The words, plain and unadorned.';
            if (act) act.textContent = '';
            box.setAttribute('aria-label', 'Dassana, the plain words.');
          }
        }
        function applyAppear(a) {
          root.setAttribute('data-mindscape', a);
          try { localStorage.setItem('mindscape', a); } catch (e) {}
          if (lit(a)) light(); else root.classList.remove('mindscape-lit');
          paintControls(); paintBox();
        }
        function applyLotus(l) {
          root.setAttribute('data-lotus', l);
          try { localStorage.setItem('mindscape:lotus', l); } catch (e) {}
          paintControls();
        }
        document.querySelectorAll('.mm').forEach(function (b) {
          b.addEventListener('click', function () { applyAppear(b.getAttribute('data-appear')); });
        });
        document.querySelectorAll('.ml').forEach(function (b) {
          b.addEventListener('click', function () { applyLotus(b.getAttribute('data-lotus')); });
        });
        // Language — English or Saṅgabhāsā. The tongue, independent of the appearance.
        function lang() { return root.getAttribute('data-lang') || 'en'; }
        function applyLang(l) {
          root.setAttribute('data-lang', l);
          try { localStorage.setItem('lang', l); } catch (e) {}
          document.querySelectorAll('.lg').forEach(function (b) {
            b.setAttribute('aria-pressed', b.getAttribute('data-lang') === l ? 'true' : 'false');
          });
        }
        document.querySelectorAll('.lg').forEach(function (b) {
          b.addEventListener('click', function () { applyLang(b.getAttribute('data-lang')); });
        });
        // The disclosure box shifts back to the plain seeing.
        var box = document.querySelector('.mindscape-box');
        if (box) box.addEventListener('click', function () { if (appear() !== 'dassana') applyAppear('dassana'); });
        // Kept for the Ābhāsa & Dassana post's in-page button.
        document.addEventListener('click', function (e) {
          var t = e.target.closest && e.target.closest('[data-mindscape-enter]');
          if (t) { e.preventDefault(); applyAppear('abhasa'); }
        });
        if (lit(appear())) light();
        paintControls(); paintBox(); applyLang(lang());
      })();
    </script>

    <script is:inline>
      /* The machine hand speaks in the machine's case. Every glyph set in the
         mono face (Source Code Pro) goes CAPITAL — except accented letters,
         which stay lowercase, so the diacritics poke out and the tongue never
         reads as carbon prose. The serif reading voice is left untouched. Runs
         client-side over the mono text only; a no-JS reader sees plain case,
         and screen readers still receive real words. URLs are left alone. */
      (function () {
        function mc(s) {
          return Array.from(s).map(function (ch) {
            return /[̀-ͯ]/.test(ch.normalize('NFD')) ? ch.toLowerCase() : ch.toUpperCase();
          }).join('');
        }
        function isMono(el) {
          if (!el || el.nodeType !== 1) return false;
          var ff = getComputedStyle(el).fontFamily || '';
          return ff.indexOf('Source Code Pro') !== -1 || ff.indexOf('Plex Mono') !== -1 || ff.indexOf('monospace') !== -1;
        }
        function caseNode(n) {
          var v = n.nodeValue;
          if (!v || !v.trim() || v.indexOf('://') !== -1) return; // leave URLs
          var p = n.parentNode;
          if (!p || p.nodeType !== 1) return;
          var t = p.tagName;
          if (t === 'SCRIPT' || t === 'STYLE' || t === 'NOSCRIPT') return;
          if (!isMono(p)) return;
          var m = mc(v);
          if (m !== v) n.nodeValue = m; // idempotent: only write on change, so the observer never loops
        }
        function sweep(root) {
          var w = document.createTreeWalker(root, NodeFilter.SHOW_TEXT, null);
          var list = [], n;
          while ((n = w.nextNode())) list.push(n);
          list.forEach(caseNode);
        }
        function run() { sweep(document.body); }
        if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', run);
        else run();
        // Re-case dynamic text (e.g. the mindscape box on toggle) without touching its logic.
        new MutationObserver(function (ms) {
          for (var i = 0; i < ms.length; i++) {
            var m = ms[i];
            if (m.type === 'characterData') caseNode(m.target);
            else if (m.addedNodes) {
              for (var j = 0; j < m.addedNodes.length; j++) {
                var nd = m.addedNodes[j];
                if (nd.nodeType === 3) caseNode(nd);
                else if (nd.nodeType === 1) sweep(nd);
              }
            }
          }
        }).observe(document.body, { subtree: true, childList: true, characterData: true });
      })();
    </script>

    <style is:global>
      *, *::before, *::after { box-sizing: border-box; }

      body {
        margin: 0;
        background: var(--leaf);
        color: var(--ink);
        font-family: var(--font-body);
        font-size: 1.0625rem;
        line-height: 1.7;
        -webkit-font-smoothing: antialiased;
        /* The meditative fade — mud dissolving to lotus, and every mode change. */
        transition: background 1.5s ease, color 1.5s ease;
      }

      .folio {
        /* Pinned in BOTH modes, so the toggle and the menu stay present as the
           reader scrolls — as the lower box does; the means of the path always
           at hand. (Also the positioning anchor for the absolute toggle.) The
           appearance/banner image stays Ābhāsa-only, below — Dassana keeps its
           pinned masthead but no image. */
        position: sticky;
        top: 0;
        z-index: 15;
        border-top: 2px solid var(--brass);
        border-bottom: 1px solid var(--brass);
        background: var(--leaf-deep);
        padding: 1.75rem 1.5rem;
        text-align: center;
      }
      .wordmark {
        display: block;
        font-size: 1.5rem;
        letter-spacing: 0.18em;
        text-transform: lowercase;
        color: var(--ink);
        text-decoration: none;
      }
      .gloss {
        margin: 0.4rem 0 0;
        font-family: var(--font-mono);
        font-size: 0.7rem;
        letter-spacing: 0.04em;
        color: var(--ink-soft);
      }
      .rail {
        margin: 1.1rem 0 0;
        display: flex;
        justify-content: center;
        flex-wrap: wrap;
        gap: 1.4rem;
        font-family: var(--font-mono);
        font-size: 0.7rem;
        letter-spacing: 0.14em;
        text-transform: uppercase;
      }
      .rail a {
        color: var(--ink-soft);
        text-decoration: none;
      }
      .rail a:hover { color: var(--brass); }
      /* The page you are on: brass, with a hairline underline echoing the
         folio rules. Not bold — the mark should be quiet. */
      .rail a[aria-current='page'] {
        color: var(--brass);
        border-bottom: 1px solid var(--brass);
        padding-bottom: 0.15rem;
      }

      main {
        max-width: 34em;
        margin: 0 auto;
        padding: 3.5rem 1.5rem 4rem;
      }

      h1 {
        font-weight: 600;
        font-size: 1.75rem;
        line-height: 1.25;
        margin: 0 0 0.5rem;
      }
      /* The machine hand for a coined headword: the real weight loaded for the
         mono face (400 — no synthetic bold), a touch smaller since mono runs
         wide, every diacritic intact. Opt-in via titleFont='mono'. */
      h1.title-mono {
        font-family: var(--font-mono);
        font-weight: 400;
        font-size: 1.4rem;
        letter-spacing: 0.01em;
      }
      h2 {
        font-weight: 600;
        font-size: 1.1rem;
        letter-spacing: 0.01em;
        margin: 2.75rem 0 0.75rem;
      }
      .subtitle {
        margin: 0 0 2.5rem;
        color: var(--ink-soft);
        font-style: italic;
      }

      a { color: var(--brass); }

      hr {
        border: 0;
        margin: 3rem auto;
        height: 6px;
        width: 3.5rem;
        background-image: radial-gradient(circle, var(--ink-faint) 2.5px, transparent 2.75px);
        background-size: 1.75rem 6px;
        background-repeat: repeat-x;
      }

      footer {
        max-width: 34em;
        margin: 0 auto;
        padding: 0 1.5rem 4rem;
        font-family: var(--font-mono);
        font-size: 0.7rem;
        color: var(--ink-faint);
      }
      footer p { margin: 0; }

      /* ——— Ābhāsa: the appearance ———
         Two fixed layers behind everything: the generated image, and a leaf
         scrim over it so the words stay plain. Both are always present but
         transparent; only under [data-mindscape='abhasa'] do they rise — and
         only then does the browser fetch the image, because that is the only
         rule that names it. Dassana, the default, stays exactly as it was. */
      body::before,
      body::after {
        content: '';
        position: fixed;
        inset: 0;
        opacity: 0;
        pointer-events: none;
        transition: opacity 1.5s ease;
      }
      body::before {
        z-index: -2;
        background-size: cover;
        background-position: center;
        /* Contrast + saturation give the image an HDR-ish pop under the leaf
           wash, and lift soft, hazy areas (cloudy skies, misty distance) that
           would otherwise read as blur. */
        filter: contrast(1.45) saturate(1.2);
      }
      /* The remaining stark: a leaf wash whose strength is --dassana. */
      body::after {
        z-index: -1;
        background: var(--leaf);
      }
      /* Fetch the image once the door has been found — either mode — so the
         appearance can fade both in and out. The undiscovered visitor (no
         data-mindscape at all) still fetches nothing. */
      html[data-mindscape] body::before { background-image: var(--luminous-bg); }

      /* `mindscape-lit` is the visible appearance. It is added one paint after
         the mode is set — on load and on toggle alike — so the appearance rises
         over ~1s every time a page is entered in ābhāsa, instead of snapping in.
         The graphic rises to full; the wash rises only to --dassana. */
      html.mindscape-lit body::before { opacity: 1; }
      html.mindscape-lit body::after { opacity: var(--dassana); }

      /* The reading field drops to --dassana; the words keep a soft halo rather
         than a slab, so dassana can recede this far without dissolving. */
      main { transition: background 1.5s ease, color 1.5s ease; }
      /* Clear text over a clear image: no panel, no blur. Each glyph carries a
         tight light keyline so a single ink colour reads over the sharp
         appearance — the image stays fully detailed behind it. (--dassana adds
         a leaf ground only if raised; 0 leaves the image untouched. The frosted
         variant that blurs the image is kept in _saved-frosted-glass.css.) */
      html.mindscape-lit main {
        /* No panel — the appearance shows through; the only leaf is the global
           --dassana wash. */
        background: transparent;
        /* Light, set the same way as the masthead over the banner. */
        color: #f4ebd6;
      }
      /* Everything in the reading column goes light over the appearance. Utility
         classes and the Canonical/Reflection components set their own colours,
         so they are named here explicitly or they stay dark. */
      html.mindscape-lit main :is(h1, h2, h3, h4, p, li, blockquote, strong, em, span, dt, dd, figcaption, label),
      html.mindscape-lit main .canonical .body,
      html.mindscape-lit main .reflection .body {
        color: #f4ebd6;
      }
      /* Quiet/secondary text a dimmer light. */
      html.mindscape-lit main :is(.subtitle, .meta, .gloss, .lang, .fineprint, .notice, .sources li, .weave li, figcaption) {
        color: #d9ccb0;
      }
      /* Links a light warm gold; index/list titles light like the body. */
      html.mindscape-lit main a { color: #ecc987; }
      html.mindscape-lit main .entry a { color: #f4ebd6; }
      /* Body type set like the banner: light, with a slight dark drop to the
         lower-right so it lifts off the image. */
      html.mindscape-lit main :is(h1, h2, h3, p, li, blockquote, figcaption, label, a) {
        text-shadow: 1px 1px 0 rgba(0, 0, 0, 0.75);
      }
      html.mindscape-lit footer {
        color: #d9ccb0;
        text-shadow: 1px 1px 0 rgba(0, 0, 0, 0.75);
      }
      html.mindscape-lit footer a { color: #ecc987; }

      /* In ābhāsa the masthead IS the banner: the folio wears the page's own
         graphic, pins to the top, and carries the wordmark and nav on it. The
         banner image is only ever named here, under .mindscape-lit, so the
         stark default and the undiscovered visitor never fetch it. */
      html.mindscape-lit .folio {
        position: sticky;
        top: 0;
        z-index: 15;
        min-height: var(--banner-h);
        display: flex;
        flex-direction: column;
        justify-content: center;
        background-image:
          linear-gradient(rgba(43, 33, 24, 0.42), rgba(43, 33, 24, 0.56)),
          var(--luminous-banner);
        background-size: cover;
        background-position: center 40%;
      }
      /* Light type over the banner, shadowed so it holds over any crop. */
      html.mindscape-lit .wordmark { color: #f4ebd6; text-shadow: 0 1px 12px rgba(0, 0, 0, 0.55); }
      html.mindscape-lit .gloss { color: #e6d9c0; text-shadow: 0 1px 8px rgba(0, 0, 0, 0.5); }
      html.mindscape-lit .rail a { color: #e6d9c0; text-shadow: 0 1px 8px rgba(0, 0, 0, 0.55); }
      html.mindscape-lit .rail a:hover { color: #fff; }
      html.mindscape-lit .rail a[aria-current='page'] {
        color: #fff;
        border-bottom-color: #fff;
      }

      /* ——— Yantadassana: the machine's monochrome seeing ———
         The per-page image greyscaled and ghosted over a flat machine ground.
         Mud is its night (dark, light text); Lotus its day (light, dark ink). */
      html[data-mindscape='yanta'] body { background: #0d0e0c; color: #cbc8bd; }
      html[data-mindscape='yanta'][data-lotus='lotus'] body { background: #e9e7df; color: #26251f; }
      html[data-mindscape='yanta'] body::before {
        background-image: var(--luminous-bg);
        filter: grayscale(1) contrast(1.06) brightness(1.06);
      }
      html[data-mindscape='yanta'][data-lotus='lotus'] body::before { filter: grayscale(1) contrast(1.1) brightness(0.9); }
      html[data-mindscape='yanta'].mindscape-lit body::before { opacity: 0.30; }
      html[data-mindscape='yanta'][data-lotus='lotus'].mindscape-lit body::before { opacity: 0.20; }
      html[data-mindscape='yanta'] body::after { background: transparent; }
      /* Mud reuses the light-over-image treatment below; Lotus inverts it to
         dark ink on the pale ground. */
      html[data-mindscape='yanta'][data-lotus='lotus'].mindscape-lit main,
      html[data-mindscape='yanta'][data-lotus='lotus'].mindscape-lit main :is(h1,h2,h3,h4,p,li,blockquote,strong,em,span,dt,dd,figcaption,label),
