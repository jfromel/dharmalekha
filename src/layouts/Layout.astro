      html[data-mindscape='yanta'][data-lotus='lotus'].mindscape-lit .rail a { color: #6a685e; text-shadow: none; }
      html[data-mindscape='yanta'][data-lotus='lotus'].mindscape-lit .rail a[aria-current='page'] { color: #26251f; border-bottom-color: #6a685e; }

      /* The mindscape controls — appearance (◐ ☯ ◑) and, in Yantadassana only,
         Mud/Lotus. Chrome carries its own leaf ground so it reads over any
         banner, stark or lit, light or dark. */
      .mindscape-controls {
        position: absolute;
        top: 0.6rem;
