---
import '@fontsource/spectral/400.css';
import '@fontsource/spectral/400-italic.css';
import '@fontsource/spectral/600.css';
import '@fontsource/ibm-plex-mono/400.css';
import '../styles/tokens.css';

interface Props {
  title: string;
  subtitle?: string;
}
// Accept props directly (.astro pages) or via markdown frontmatter (.md pages
// that use this file as their `layout`), so /terms and /privacy can be plain
// markdown and still get the folio masthead.
const props = Astro.props as { title?: string; subtitle?: string; frontmatter?: { title?: string; subtitle?: string } };
const title = props.title ?? props.frontmatter?.title ?? '';
const subtitle = props.subtitle ?? props.frontmatter?.subtitle;

const nav = [
  { href: '/', label: 'Writings' },
  { href: '/numerations/', label: 'Numerations' },
  { href: '/ask/', label: 'Ask' },
  { href: '/writings/colophon/', label: 'Colophon' },
  { href: '/about/', label: 'About' },
];
// Current when the path is this link's page. Home matches only the root;
// the others match their section so a deeper URL still marks its parent.
const path = Astro.url.pathname;
const isCurrent = (href: string) =>
  href === '/' ? path === '/' : path.startsWith(href.replace(/\/$/, ''));
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} — Dharmalekha</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <header class="folio">
      <a class="wordmark" href="/">Dharmalekha</a>
      <p class="gloss">dhamma + lekhā — dharma writing, freely given</p>
      <nav class="rail" aria-label="Primary">
        {nav.map((item) => (
          <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
            {item.label}
          </a>
        ))}
      </nav>
    </header>

    <main>
      <h1>{title}</h1>
      {subtitle && <p class="subtitle">{subtitle}</p>}
      <slot />
    </main>

    <footer>
      <p>Site text CC0. Translation licences are named on each quotation.</p>
      <p style="margin-top:0.5rem"><a href="/terms/">Terms</a> · <a href="/privacy/">Privacy</a></p>
    </footer>

    <style is:global>
      *, *::before, *::after { box-sizing: border-box; }

      body {
        margin: 0;
        background: var(--leaf);
        color: var(--ink);
        font-family: var(--font-body);
        font-size: 1.0625rem;
        line-height: 1.7;
        -webkit-font-smoothing: antialiased;
      }

      .folio {
        border-top: 2px solid var(--brass);
        border-bottom: 1px solid var(--brass);
        background: var(--leaf-deep);
        padding: 1.75rem 1.5rem;
        text-align: center;
      }
      .wordmark {
        display: block;
        font-size: 1.5rem;
        letter-spacing: 0.18em;
        text-transform: lowercase;
        color: var(--ink);
        text-decoration: none;
      }
      .gloss {
        margin: 0.4rem 0 0;
        font-family: var(--font-mono);
        font-size: 0.7rem;
        letter-spacing: 0.04em;
        color: var(--ink-soft);
      }
      .rail {
        margin: 1.1rem 0 0;
        display: flex;
        justify-content: center;
        flex-wrap: wrap;
        gap: 1.4rem;
        font-family: var(--font-mono);
        font-size: 0.7rem;
        letter-spacing: 0.14em;
        text-transform: uppercase;
      }
      .rail a {
        color: var(--ink-soft);
        text-decoration: none;
      }
      .rail a:hover { color: var(--brass); }
      /* The page you are on: brass, with a hairline underline echoing the
         folio rules. Not bold — the mark should be quiet. */
      .rail a[aria-current='page'] {
        color: var(--brass);
        border-bottom: 1px solid var(--brass);
        padding-bottom: 0.15rem;
      }

      main {
        max-width: 34em;
        margin: 0 auto;
        padding: 3.5rem 1.5rem 4rem;
      }

      h1 {
        font-weight: 600;
        font-size: 1.75rem;
        line-height: 1.25;
        margin: 0 0 0.5rem;
      }
      h2 {
        font-weight: 600;
        font-size: 1.1rem;
        letter-spacing: 0.01em;
        margin: 2.75rem 0 0.75rem;
      }
      .subtitle {
        margin: 0 0 2.5rem;
        color: var(--ink-soft);
        font-style: italic;
      }

      a { color: var(--brass); }

      hr {
        border: 0;
        margin: 3rem auto;
        height: 6px;
        width: 3.5rem;
        background-image: radial-gradient(circle, var(--ink-faint) 2.5px, transparent 2.75px);
        background-size: 1.75rem 6px;
        background-repeat: repeat-x;
      }

      footer {
        max-width: 34em;
        margin: 0 auto;
        padding: 0 1.5rem 4rem;
        font-family: var(--font-mono);
        font-size: 0.7rem;
        color: var(--ink-faint);
      }
      footer p { margin: 0; }
    </style>
  </body>
</html>
