---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';

const writings = (await getCollection('writings'))
  .filter((w) => !w.data.draft)
  .sort((a, b) => b.data.published.valueOf() - a.data.published.valueOf());
---

<Layout title="Writings" subtitle="Everything here is marked with its provenance.">
  <ul class="index">
    {writings.map((w) => (
      <li class={`entry ${w.data.tier}`}>
        <a href={`/writings/${w.id}/`}>{w.data.title}</a>
        <p class="meta">
          {w.data.published.toISOString().slice(0, 10)}
          <span class="sep">·</span>
          {w.data.tier}
        </p>
      </li>
    ))}
    {writings.length === 0 && <li class="meta">Nothing published yet.</li>}
  </ul>
</Layout>

<style>
  .index { list-style: none; margin: 0; padding: 0; }
  .entry {
    margin: 0 0 2rem;
    padding-left: var(--rail-gap);
  }
  .entry.canonical { border-left: 3px solid var(--brass); }
  .entry.commentary { border-left: 1px solid var(--ink-soft); }
  .entry.reflection {
    background-image: repeating-linear-gradient(
      to bottom, var(--ink-faint) 0 5px, transparent 5px 11px);
    background-repeat: no-repeat;
    background-size: 1px 100%;
    background-position: left top;
  }
  .entry a { text-decoration: none; font-size: 1.15rem; }
  .entry a:hover { text-decoration: underline; }
  .meta {
    margin: 0.2rem 0 0;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--ink-faint);
  }
  .sep { margin: 0 0.5em; }
</style>
