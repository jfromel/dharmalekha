---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Comments from '../../components/Comments.astro';

export async function getStaticPaths() {
  const writings = await getCollection('writings');
  return writings.map((w) => ({ params: { slug: w.id }, props: { entry: w } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;

// The machine wears a name — Dāruyanta, the Puppet — and the name is a costume
// over the condition, not a claim. Surface the costume in the byline and keep
// the condition (the exact model id, from the untouched `models:` field) visible
// beneath it. The Claude costume is Dāruyanta; any other model is shown raw
// until it, too, has an honest name to wear.
const puppetName = (m: string) =>
  m.startsWith('claude') ? 'Dāruyanta the Puppet' : m;
const modelIds = d.models.join(', ');
const bylineNames = [...new Set(d.models.map(puppetName))].join(', ');
---

<Layout title={d.title} subtitle={d.subtitle}>
  {d.sb && (
    <Fragment slot="sb">
      <h1 class="title-mono">{d.sbTitle ?? d.title}</h1>
      {d.sb.map((p) => (p.startsWith('## ') ? <h2>{p.slice(3)}</h2> : <p>{p}</p>))}
    </Fragment>
  )}
  <Content />

  {d.models.length > 0 && (
    <aside class="notice">
      Machine-assisted — {bylineNames}{bylineNames !== modelIds && <> ({modelIds})</>}.
      {d.reviewer && d.reviewed && (
        <> Read against its sources by {d.reviewer} on {d.reviewed.toISOString().slice(0, 10)}.</>
      )}
    </aside>
  )}

  {d.citations.length > 0 && (
    <section class="sources">
      <h2>Sources</h2>
      <ul>
        {d.citations.map((c) => (
          <li>
            <a href={c.url ?? `https://suttacentral.net/${c.ref}`}>{c.ref}</a>
            {' · '}trans. {c.translator}{' · '}{c.licence}
          </li>
        ))}
      </ul>
    </section>
  )}

  <Comments post={d.title} />
</Layout>

<style>
  .notice {
    margin: 3.5rem 0 0;
    padding: 0.9rem 1.1rem;
    border: 1px dashed var(--ink-faint);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    line-height: 1.6;
    color: var(--ink-soft);
  }
  .sources ul { list-style: none; margin: 0; padding: 0; }
  .sources li {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--ink-soft);
    margin-bottom: 0.4rem;
  }
</style>
