      html[data-lang='en'] .lang-sb { display: none; }
      html[data-lang='sb'] .lang-en { display: none; }
      .lang-sb, .sb-page { font-family: var(--font-mono); }
      .sb-fallback { font-size: 1.05rem; line-height: 1.6; margin: 2rem 0 0.4rem; }
      .sb-fallback-gloss { font-family: var(--font-body); font-style: italic; font-size: 0.85rem; color: var(--ink-soft); margin: 0; }
      .lang-toggle {
        display: inline-flex;
